<Window x:Class="SystemOneProductivityTracker.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SystemOneProductivityTracker.Wpf.ViewModels"
        xmlns:views="clr-namespace:SystemOneProductivityTracker.Wpf.Views"
        Title="SystemOne Productivity Tracker" Height="550" Width="850"
        WindowStartupLocation="CenterScreen" Background="#1E1E2E">

	<Window.Resources>
		<DataTemplate DataType="{x:Type vm:LoginViewModel}">
			<views:LoginView />
		</DataTemplate>

		<DataTemplate DataType="{x:Type vm:DashboardViewModel}">
			<Grid Background="#1E1E2E">
				<StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
					<TextBlock Text="{Binding WelcomeText}" Foreground="White" FontSize="20" Margin="0,0,0,16"/>
                    <TextBlock Text="{Binding CurrentProcesses}" Foreground="White" FontSize="20" Margin="0,0,0,16"/>
                    <TextBlock Text="{Binding PrcessScanCount}" Foreground="White" FontSize="20" Margin="0,0,0,16"/>
                    <Button Content="Trigger Dashboard Action"
                        Command="{Binding ActionCommand}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Padding="20,12"
                        Background="#89B4FA"
                        Foreground="#11111B"
                        FontWeight="Bold"
                        FontSize="14"
                        BorderThickness="0"
                        Cursor="Hand" />
					<Button Content="Wyloguj" Command="{Binding LogoutCommand}" Padding="12,6"/>
				</StackPanel>
			</Grid>
		</DataTemplate>
	</Window.Resources>
	
	<ContentControl Content="{Binding CurrentViewModel}" />
</Window>