<UserControl x:Class="SystemOneProductivityTracker.Wpf.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
             Background="#1E1E2E" Foreground="White">
    <Grid Width="320" VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel>
            <TextBlock Text="SystemOne Tracker" FontSize="24" FontWeight="Bold" 
                       HorizontalAlignment="Center" Margin="0,0,0,24"/>

            <TextBlock Text="Adres E-mail" Margin="0,0,0,4" Foreground="#A6ADC8"/>
            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" 
                     Padding="8" Margin="0,0,0,16" Background="#313244" Foreground="White" BorderThickness="0"/>

            <TextBlock Text="Hasło" Margin="0,0,0,4" Foreground="#A6ADC8"/>
            <PasswordBox x:Name="PwdBox" Padding="8" Margin="0,0,0,16" 
                         Background="#313244" Foreground="White" BorderThickness="0"/>

            <TextBlock Text="{Binding ErrorMessage}" Foreground="#F38BA8" 
                       TextWrapping="Wrap" Margin="0,0,0,12"/>

            <Button Content="Zaloguj się" 
                    Command="{Binding LoginCommand}" 
                    CommandParameter="{Binding ElementName=PwdBox}"
                    Padding="10" Margin="0,0,0,8" Background="#89B4FA" Foreground="#11111B" FontWeight="Bold" BorderThickness="0"/>

            <Button Content="Utwórz nowe konto" 
                    Command="{Binding RegisterCommand}" 
                    CommandParameter="{Binding ElementName=PwdBox}"
                    Padding="8" Background="Transparent" Foreground="#89B4FA" BorderThickness="1" BorderBrush="#89B4FA"/>
        </StackPanel>
    </Grid>
</UserControl>