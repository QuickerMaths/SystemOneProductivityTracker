<UserControl x:Class="SystemOneProductivityTracker.Wpf.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E2E" Foreground="White">
    <Grid>
        <TextBlock Text="{Binding CurrentActivityName}" FontWeight="Bold" />
        <TextBlock Text="{Binding CurrentActivityDuration}" />
    </Grid>
</UserControl>